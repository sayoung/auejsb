/**
 * Implements hook_entity_insert().
 */
 

 
function d8mail_entity_insert(Drupal\Core\Entity\EntityInterface $entity) {

  if ($entity->getEntityTypeId() !== 'node' || ($entity->getEntityTypeId() === 'node' && $entity->bundle() !== 'pre_instruction')) {
    return;
  }


  Instruction::sendMail($entity->get('field_email_')->value,$entity->get('field_code_s')->value, 'Instruction');
}
function d8mail_entity_update(Drupal\Core\Entity\EntityInterface $entity) {
 
 if ($entity->getEntityTypeId() !== 'node' || ($entity->getEntityTypeId() === 'node' && $entity->bundle() !== 'pre_instruction')) {
    return;
  }
  if (($entity->get('moderation_state')->target_id ) === 'instruction_dispatcher') {
	Instruction::sendMailFinal($entity->get('field_email_')->value, $entity->get('field_code_s')->value, 'Instruction');

}  
  
}
function d8mail_node_presave(Drupal\node\NodeInterface $node) {
if (($node->get('moderation_state')->target_id ) === 'instruction_dispatcher') {
//	Instruction::sendMailFinal($entity->get('field_email_')->value, $entity->get('field_code_s')->value, 'Instruction');
	$node->set('field_cheking', 0);
}  
}
/**  
 * Implements hook_mail().
 */
function d8mail_mail($key, &$message, $params) {
  $options = array(
    'langcode' => $message['langcode'],
  );

  switch ($key) {
    case 'node_insert':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('@title', array('@title' => $params['node_title']), $options);
      $message['body'][] = $params['message'];
      break;
  }
}

/**
 * Implements hook_mail_alter().
 */
function d8mail_mail_alter(&$message) {
  switch ($message['key']) {
    case 'node_insert':
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
      break;
  }
}

// Branding helpers (shared with notemail when that module is available).
if (!function_exists('_notemail_branding_is_wrong')) {
  function _notemail_branding_is_wrong($text) {
    foreach (['Nador', 'AUNADOR', 'Driouch', 'Guercif', 'Beni Mellal'] as $needle) {
      if (stripos((string) $text, $needle) !== FALSE) {
        return TRUE;
      }
    }
    return FALSE;
  }
}
if (!function_exists('_notemail_branding_replace_string')) {
  function _notemail_branding_replace_string($text) {
    $map = [
      'Agence Urbaine de Nador-Driouch-Guercif' => "Agence Urbaine d'El Jadida-Sidi Bennour",
      'Agence urbaine de Nador-Driouch-Guercif' => "Agence Urbaine d'El Jadida-Sidi Bennour",
      "L'Agence Urbaine de Nador-Driouch-Guercif" => "L'Agence Urbaine d'El Jadida-Sidi Bennour",
      "l'Agence Urbaine de Nador-Driouch-Guercif" => "l'Agence Urbaine d'El Jadida-Sidi Bennour",
      'AUNADOR' => 'AUEJSB',
      "L'Agence Urbaine de Beni Mellal" => "L'Agence Urbaine d'El Jadida-Sidi Bennour",
      'Agence Urbaine de Beni Mellal' => "Agence Urbaine d'El Jadida-Sidi Bennour",
    ];
    return strtr((string) $text, $map);
  }
}
if (!function_exists('_notemail_branding_footer')) {
  function _notemail_branding_footer($value, $fallback = "Agence Urbaine d'El Jadida-Sidi Bennour") {
    $value = trim((string) $value);
    if ($value === '' || _notemail_branding_is_wrong($value)) {
      return $fallback;
    }
    return _notemail_branding_replace_string($value);
  }
}